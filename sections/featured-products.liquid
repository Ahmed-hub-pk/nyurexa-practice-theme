{{ 'cards.css' | asset_url | stylesheet_tag }}

<section class="featured">
  <h2>{{ section.settings.heading }}</h2>
  <div class="cards">
    {% for product in collections.all.products limit: section.settings.product_count %}
      <div class="card">
        {% if product.featured_image %}
{{ product.featured_image | image_url: width: 600 | image_tag: alt: product.title, widths: '200, 400, 600', sizes: '(max-width: 600px) 100vw, 33vw' }}
        {% endif %}
        <h3>{{ product.title }}</h3>
        <p>{{ product.price | money }}</p>
{% if product.metafields.custom.material %}
  <p>Material: {{ product.metafields.custom.material.value }}</p>
{% endif %}
{% if product.metafields.custom.origin %}
  <p>Origin: {{ product.metafields.custom.origin.value }}</p>
{% endif %}
<a class="btn" href="{{ product.url }}" aria-label="View {{ product.title }}">View product</a>
      </div>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Featured products",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Featured products" },
    { "type": "range", "id": "product_count", "label": "Number of products", "min": 2, "max": 6, "step": 1, "default": 3 }
  ],
  "presets": [ { "name": "Featured products" } ]
}
{% endschema %}