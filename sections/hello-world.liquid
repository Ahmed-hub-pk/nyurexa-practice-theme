{% comment %}
  Welcome to Shopify theme development!
{% endcomment %}
{{ 'cards.css' | asset_url | stylesheet_tag }}

<div class="welcome full-width">
  <div class="welcome-content">
    <div>
      <h1>Hello, Nyurexa!</h1>
<h2>Welcome to {{ shop.name}}</h2>
<p>{{ 'now' | date: '%A %d %B' }}</p>

{% if shop.name == 'practice store 1' %}
<p> This is my practice shop.</p>
{% else %}
<p>This is a different shop.</p>
{% endif %}

{% assign fruits ='Apple,Banana,Mango' | split: ',' %}
<ul>
{% for fruit in fruits %}
<li>{{ fruit }}</li>
{% endfor %}
</ul>

{% assign age = 20 %}
{% if age >= 18 and age < 60 %}
<p>Adult</p>
{% endif %}

{% unless age < 18 %}
<p>Not a child</p>
{% endunless %}

{% assign day = 'Monday' %}
{% case day %}
{% when 'Friday' or 'Saturday' %}
<p>Weekend soon</p>
{% when 'Sunday' %}
<p> Rest day</p>
{% else %}
<p>Normal day</p>
{% endcase %}
{% if day == 'Saturday' or day == 'Sunday' %}
<p>Weekend</p>
{% endif %}

{% assign word ='shopify liquid' %}
<p>{{ word | upcase }}</p>
<p>{{ word | capitalize }}</p>
<p>{{ word | append: ' is fun' }}</p>
<p>{{ word | size }}</p>
<p>{{ missing | default: 'Nothing here' }}</p>

{% capture greeting %} Hello,
{{ shop.name }}!{% endcapture %}
<p>{{ greeting }}</p>
{% for fruit in fruits %}
{% if fruit == 'Banana' %}
{% break %}
{% endif %}
<p>{{ fruit }}</p>
{% endfor %}

{% if section.settings.banner_image %}
  {{ section.settings.banner_image | image_url: width: 400 | image_tag }}
{% endif %}

<h2 style="color: {{ section.settings.heading_color }}; font-size: {{section.settings.heading_size }}">{{section.settings.heading }}</h2>
<ul>
{% assign sorted = collections.all.products | sort: 'price' | reverse %}
{% for product in sorted limit: section.settings.count %}
{% render 'product-item', product: product, forloop: forloop, show_price: section.settings.show_price %}
{% endfor %}
{% assign all_products = collections.all.products%}
{% assign in_stock = all_products | where: 'available', true %}
<p>All products: {{ all_products | size }} |In stock: {{ in_stock | size }}</p>
<h3> In stock now</h3>
<ul>
{% for product in in_stock %}
<li>{{ product.title }} - {{ product.price | money }}</li>
{% endfor %}
</ul>

<div class="cards">
{% for product in collections.all.products %}
{% endfor %}
</div>

{% paginate collections.all.products by 2 %}              
<div class="cards">
{% for product in collections.all.products %}
<div class="card">
    {% if product.featured_image %}
      {{ product.featured_image | image_url: width: 300 | image_tag }}
    {% endif %}
{% if product.images.size > 1 %}
  <div class="thumbs">
    {% for image in product.images offset: 1 limit: 3 %}
      {% assign alt_text = image.alt | default: product.title %}
      {{ image | image_url: width: 80 | image_tag: alt: alt_text }}
    {% endfor %}
  </div>
{% endif %}
    <h3><a href="{{ product.url }}">{{ product.title }}</a></h3>
    <p>{{ product.price | money }}</p>
    {% if product.available %}
      <p class="in">In stock</p>
    {% else %}
      <p class="out">Sold out</p>
    {% endif %}
<a class="btn" href="{{ product.url }}">View product</a>
  </div>
{% endfor %}
</div>
{{ paginate | default_pagination }}                       
{% endpaginate %} 

<ul>
{% for block in section.blocks %}
  {% case block.type %}
    {% when 'item' %}
      <li {{ block.shopify_attributes }}>{{ block.settings.text }}</li>
    {% when 'link' %}
      <li {{ block.shopify_attributes }}><a href="{{ block.settings.link }}">{{ block.settings.label }}</a></li>
  {% endcase %}
{% endfor %}
</ul>

      <p class="welcome-description">
        Welcome to my first Shopify practice shop </p>

      <p class="welcome-description">
        Themes shape the online store experience for merchants and their customers. Build fast, flexible themes at scale
        using Liquid, Shopify's theme templating language, along with HTML, CSS, JavaScript, and JSON.
      </p>
    </div>
    <div class="icon">
      <img src="{{ 'shoppy-x-ray.svg' | asset_url }}" width="300" height="300">
    </div>
  </div>
</div>

<div class="highlights">
  <div class="highlight">
    <h3>Key Concepts</h3>
    <p class="highlight-description">
      Shopify themes are a package of template files, building blocks, and supporting assets. Use these building blocks
      to create modular, customizable themes.
    </p>
    <p>{{ 'Learn more about key concepts' | link_to: 'https://shopify.dev/docs/storefronts/themes/architecture' }}</p>
  </div>

  <div class="highlight">
    <h3>Liquid</h3>
    <p class="highlight-description">
      The Liquid templating language is the backbone of Shopify themes, and is used to load dynamic content on
      storefronts. Extend Liquid objects to store and present custom data using metafields.
    </p>
    <p>{{ 'View the Liquid reference' | link_to: 'https://shopify.dev/docs/api/liquid' }}</p>
  </div>

  <div class="highlight">
    <h3>Best Practices</h3>
    <p class="highlight-description">
      To optimize your theme development experience, Shopify has established a set of best practices that you can refer
      to when developing your theme and setting up your toolchains and processes.
    </p>
    <p>{{ 'Follow best practices' | link_to: 'https://shopify.dev/docs/storefronts/themes/best-practices' }}</p>
  </div>
</div>

<p>Cart items: <span id="cart-count">{{ cart.item_count }}</span></p>
<p id="cart-msg"></p>

<h3>Your cart</h3>
<ul id="cart-list">
  {% for item in cart.items %}
    <li>{{ item.product.title }} ({{ item.variant.title }}) x {{ item.quantity }} - {{ item.final_line_price | money }}</li>
  {% endfor %}
</ul>
<p>Total: <strong id="cart-total">{{ cart.total_price | money }}</strong></p>
<p><a href="/cart">View cart</a></p>

<script src="{{ 'cart-ajax.js' | asset_url }}" defer></script>

{% stylesheet %}
  .welcome {
    display: grid;
    grid-template-columns: var(--content-grid);
    background-color: #fff3cd;
    padding: 72px 0;
  }

  .welcome-content {
    grid-column: 2;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    width: 100%;
    padding: 0 24px;
  }

  .welcome-description {
    max-width: 80ch;
    line-height: 1.4;
    margin-top: 1.5rem;
color: #2c3e50;
}

.welcome-content h1{
color: #c0392b;
font-size: 3rem;
  }

  .icon {
    width: 200px;
  }

  .highlights {
    display: grid;
    gap: 2rem;
    grid-template-columns: repeat(3, 1fr);
    margin-top: 50px;
  }

  @media (max-width: 1100px) {
    .highlights {
      grid-template-columns: 1fr;
    }
  }

  .highlight {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 24px;
    border-radius: 8px;
    background-color: #eef3ff;
    color: rgb(92, 95, 98);
    line-height: 1.4;
  }

  .highlight > * + * {
    margin-top: 1rem;
  }

  .highlight h3 {
    font-size: 1rem;
    color: rgb(32, 34, 35);
  }

  .highlight-description {
    flex: 1 1;
  }

  {% endstylesheet %}

{% schema %}
{
  "name": "Hello World",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading text",
      "default": "My Products"
    },
    {
      "type": "range",
      "id": "count",
      "label": "Number of products",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Show price",
      "default": true
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#cc0000"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "20px", "label": "Small" },
        { "value": "28px", "label": "Medium" },
        { "value": "40px", "label": "Large" }
      ],
      "default": "28px"
    },
    {
      "type": "image_picker",
      "id": "banner_image",
      "label": "Banner image"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Item text",
          "default": "New item"
        }
]
},
{
"type": "link",
"name": "Link",
"settings": [
{
"type": "text",
"id": "label",
"label": "Link text",
"default": "Click here"
},
{
"type": "url",
"id": "link",
"label": "Link address"
}
      ]
    }
  ],
  "presets": [
    {
      "name": "Hello World Template",
      "category": "Demo"
    }
  ]
}
{% endschema %}