<section class="banner">
  {% if section.settings.image %}
    {{ section.settings.image | image_url: width: 1500 | image_tag: alt: section.settings.heading, class: 'banner-img', widths: '600, 900, 1500', sizes: '100vw' }}
  {% endif %}
  <div class="banner-text">
    <h2>{{ section.settings.heading }}</h2>
    <p>{{ section.settings.subtext }}</p>
    {% if section.settings.button_label != blank %}
      <a class="btn" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .banner { position: relative; background: #333; }
  .banner-img { width: 100%; height: 320px; object-fit: cover; display: block; }
  .banner-text { position: absolute; inset: 0; display: flex; flex-direction: column; justify-content: center; align-items: flex-start; padding: 24px; color: #fff; background: rgba(0, 0, 0, 0.35); }
  .banner .btn { background: #f1c40f; color: #000; padding: 8px 16px; border-radius: 6px; text-decoration: none; font-weight: bold; margin-top: 8px; }
  .banner .btn:focus-visible { outline: 3px solid #fff; outline-offset: 2px; }
{% endstylesheet %}

{% schema %}
{
  "name": "Banner",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Big winter sale" },
    { "type": "text", "id": "subtext", "label": "Text", "default": "Up to 30% off selected items" },
    { "type": "text", "id": "button_label", "label": "Button text", "default": "Shop now" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [ { "name": "Banner" } ]
}
{% endschema %}